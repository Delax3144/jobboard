generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("Open")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  username       String          @unique
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  avatarPublicId String?
  lastActive     DateTime        @default(now())
  role           String
  status         String?         @default("Open to work")
  createdAt      DateTime        @default(now())
  bio            String?
  skills         String?
  experience     Json?
  supportTickets SupportTicket[]

  isVerified                 Boolean   @default(false)
  verificationTokenHash      String?   @unique
  verificationTokenExpiresAt DateTime?
  resetTokenHash             String?   @unique
  resetTokenExpiresAt        DateTime?

  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret    String?

  jobs         Job[]         @relation("UserJobs")
  applications Application[] @relation("UserApplications")

  savedJobs SavedJob[]

  isPublic           Boolean @default(true)
  showEmail          Boolean @default(false)
  soundEnabled       Boolean @default(true)
  notificationVolume Int     @default(50)
  toastsEnabled      Boolean @default(true)

  resumeUrl      String?
  resumePublicId String?
  location       String?
}

model Job {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation("UserJobs", fields: [ownerId], references: [id])

  title               String
  companyName         String
  location            String?
  level               String   @default("Junior")
  salaryFrom          Int?
  salaryTo            Int?
  description         String
  tags                String   @default("")
  status              String   @default("published")
  companyLogo         String?
  companyLogoPublicId String?
  createdAt           DateTime @default(now())

  applications Application[]

  savedBy SavedJob[]

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
}

model SavedJob {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model Application {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   User   @relation("UserApplications", fields: [candidateId], references: [id])

  coverLetter     String?
  cvUrl           String?
  cvPublicId      String?
  status          String    @default("new")
  statusUpdatedAt DateTime?

  lastViewedByCandidate DateTime @default(now())
  lastViewedByOwner     DateTime @default(now())

  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([jobId, candidateId])
  @@index([jobId, createdAt])
  @@index([candidateId, createdAt])
}

model Message {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId      String
  text          String
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
}
