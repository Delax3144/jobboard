# Local database from docker-compose.yml. Use separate credentials when deploying.
DATABASE_URL="postgresql://jobboard:jobboard@localhost:5432/jobboard?schema=public"
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Generate a random value using the command in the root README.
JWT_SECRET=replace-with-a-random-secret

# Required for email verification, password recovery, and email notifications.
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=replace-with-gmail-app-password

# Required for uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: configure to test social sign-in.
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
